        {
          "name": "Показать список доступных сеансов",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Проверяем, что статус 200",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Проверяем, что ответ — JSON и содержит поле sessions",
                  "pm.test(\"Response has sessions array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('sessions');",
                  "    pm.expect(jsonData.sessions).to.be.an('array');",
                  "});",
                  "",
                  "// Проверяем, что каждый сеанс имеет все необходимые поля",
                  "pm.test(\"Each session has required fields\", function () {",
                  "    var sessions = pm.response.json().sessions;",
                  "    sessions.forEach(function(session) {",
                  "        pm.expect(session).to.have.property('session_id');",
                  "        pm.expect(session).to.have.property('movie');",
                  "        pm.expect(session).to.have.property('hall');",
                  "        pm.expect(session).to.have.property('free_seats');",
                  "        pm.expect(session).to.have.property('start_time');",
                  "        pm.expect(session.free_seats).to.be.a('number');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/sessions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sessions"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Покупка билета id=created_ticket_id",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response contains ticket object\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('message');",
                  "    pm.expect(json).to.have.property('ticket');",
                  "    pm.expect(json.ticket).to.have.property('id');",
                  "    pm.expect(json.ticket).to.have.property('status', 'purchased');",
                  "    pm.expect(json.ticket).to.have.property('price');",
                  "    pm.expect(json.ticket.price).to.be.a('number');",
                  "});",
                  "",
                  "let jsonResponse = pm.response.json();",
                  "",
                  "// Сохраняем ID купленного билета в переменную коллекции",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set(\"created_ticket_id\", jsonResponse.ticket.id);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {}
              }
            }
          ],
