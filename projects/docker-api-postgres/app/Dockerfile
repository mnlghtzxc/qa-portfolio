# Dockerfile — инструкция для сборки образа API

# Базовый образ: легковесный Python 3.10-slim (содержит только необходимое)
FROM python:3.10-slim

# Устанавливаем рабочую директорию внутри контейнера (все последующие команды выполняются в ней)
WORKDIR /app

# Копируем файл зависимостей в текущую рабочую директорию (.)
COPY requirements.txt .

# Выполняем установку зависимостей без кеширования (экономия места в образе)
RUN pip install --no-cache-dir -r requirements.txt

# Копируем исходный код приложения
COPY app.py .

# Задаём команду, которая выполнится при старте контейнера
CMD ["python", "app.py"]
